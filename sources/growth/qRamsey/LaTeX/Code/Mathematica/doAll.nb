  "Print", "[", 
   "\"\<Solid=No costs (standard Ramsey); Dashing=With high adj costs \
(q-Ramsey)\>\"", "]"}], ";", 
  RowBox[{"Print", "[", "PolFuncAdjCost0VsHi", "]"}], ";"}]}], "Input",
 InitializationCell->True],

