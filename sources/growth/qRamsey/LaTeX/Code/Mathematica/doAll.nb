          RowBox[{"\[ScriptI]FuncAdjCostHi", "[", "\[ScriptK]", "]"}], ",", 
          RowBox[{"\[ScriptJ]FuncAdjCostHi", "[", "\[ScriptK]", "]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[ScriptK]", ",", "0", ",", 
          RowBox[{"2", "\[ScriptK]SS"}]}], "}"}], "\[IndentingNewLine]", ",", 
        
        RowBox[{"PlotStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"CostAdj0Thickness", ",", "\[ScriptC]Color"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"CostAdj0Thickness", ",", "\[ScriptI]Color"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"CostAdj0Thickness", ",", "\[ScriptJ]Color"}], "}"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{
            "CostAdjAltThickness", ",", "Dashed", ",", "\[ScriptC]Color"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "CostAdjAltThickness", ",", "Dashed", ",", "\[ScriptI]Color"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "CostAdjAltThickness", ",", "Dashed", ",", "\[ScriptJ]Color"}], 
            "}"}]}], "}"}]}], "\[IndentingNewLine]", ",", 
        RowBox[{"AxesLabel", "\[Rule]", 
         RowBox[{
         "{", "\"\<\!\(\*SubscriptBox[\(\[ScriptK]\), \(t\)]\)\>\"", "}"}]}], 
        " ", ",", 
        RowBox[{"Ticks", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
             "\[ScriptK]SS", ",", 
              "\"\<\!\(\*OverscriptBox[\(\[ScriptK]\), \(\[Hacek]\)]\)\>\""}],
              "}"}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(\[ScriptC]\), \(t\)]\)\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"\[ScriptK]SS", ",", 
             RowBox[{"\[ScriptC]SS", " ", "+", ".2"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(\[ScriptI]\), \(t\)]\)\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"\[ScriptK]SS", ",", 
             RowBox[{"\[ScriptI]SS", " ", "+", ".2"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{
          "\"\<\[LowerLeftArrow] \!\(\*SubscriptBox[\(\[ScriptJ]\), \
\(t\)]\)\>\"", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[ScriptK]SS", "/", "2"}], ",", 
             RowBox[{"\[ScriptI]SS", " ", "/", "3"}]}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
