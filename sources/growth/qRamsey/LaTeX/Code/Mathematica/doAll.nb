Cell[CellGroupData[{

Cell["\<\
Regular Ramsey model with log utility \[Rho]=1 (solid) vs high \[Rho] (Dashed \
lines)\
\>", "Subsubsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "qRamseyParamsBase.m"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]", "=", "3."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Quiet", "[", "SolvePolFunc", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[ScriptC]FuncCostAdj0AndRRAHi", ",", "\[ScriptI]FuncCostAdj0AndRRAHi", 
     ",", "\[ScriptJ]FuncCostAdj0AndRRAHi"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"\[ScriptC]Func", ",", "\[ScriptI]Func", ",", "\[ScriptJ]Func"}], 
    "}"}]}], ";"}]}], "Input",
 InitializationCell->True],

