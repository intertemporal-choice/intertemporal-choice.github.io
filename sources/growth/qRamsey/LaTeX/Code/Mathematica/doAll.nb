Cell["\<\
\[LineSeparator]Impulse Response Functions (benchmark calibration)\
\>", "Section",
 InitializationCell->True],

Cell[CellGroupData[{

Cell["Permanent increase in Patience", "Subsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "qRamseyParamsBase.m"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Quiet", "[", "SolvePolFunc", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"InitializeSimData", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{"AddOnePeriod", ",", 
    RowBox[{"{", "PreShockPeriods", "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]", "=", "0.98"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Quiet", "[", "SolvePolFunc", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{"AddOnePeriod", ",", 
    RowBox[{"{", "AfterShockPeriods", "}"}]}], "]"}], ";"}]}], "Input",
 InitializationCell->True],

