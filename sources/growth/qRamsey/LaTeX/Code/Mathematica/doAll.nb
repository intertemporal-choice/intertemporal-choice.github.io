Notebook[{

Cell[CellGroupData[{
Cell["\<\
Produce figures that illustrate how the standard Ramsey model changes when \
quadratic costs of adjustment to k are added\
\>", "Section",
 InitializationCell->True],

Cell[CellGroupData[{

Cell["Preamble (boring initialization stuff; ignore)", "Subsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<PlotLegends`\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "$FrontEnd", "]"}], " ", ">", " ", "0"}], ",", 
     " ", 
     RowBox[{"NBDir", " ", "=", " ", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}]}], "]"}], ";", 
   RowBox[{"(*", " ", 
    RowBox[{
    "If", " ", "running", " ", "from", " ", "the", " ", "Notebook", " ", 
     "interface"}], " ", "*)"}], "\n", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "$FrontEnd", "]"}], " ", "==", " ", "0"}], ",", 
     RowBox[{
     "SetDirectory", "[", 
      "\"\</Volumes/Data/Courses/Choice/LectureNotes/Growth/Handouts/qRamsey/\
Code/Mathematica/\>\"", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"Plot", "\[IndentingNewLine]", ",", 
    RowBox[{"BaseStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"FontSize", "\[Rule]", "16"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"Ticks", "\[Rule]", "None"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", "Thick", "}"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"ListPlot", "\[IndentingNewLine]", ",", 
    RowBox[{"BaseStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"FontSize", "\[Rule]", "16"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"Ticks", "\[Rule]", "None"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Black", ",", 
       RowBox[{"PointSize", "[", "Medium", "]"}]}], "}"}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"<<", "qRamseyFunctions.m"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[ScriptC]Color", ",", "\[ScriptI]Color", ",", "\[ScriptJ]Color"}], 
    "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Darker", "[", "Green", "]"}], ",", 
     RowBox[{"\[ScriptI]Color", "=", "Red"}], ",", 
     RowBox[{"\[ScriptJ]Color", "=", "Black"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CostAdj0Thickness", "=", 
   RowBox[{"Thickness", "[", "Medium", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CostAdjAltThickness", "=", 
   RowBox[{"Thickness", "[", "Large", "]"}]}], ";"}]}], "Input",
 InitializationCell->True]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Policy Functions (measuring sensitivity to \[Omega] and \[Rho])\
\>", "Section",
 InitializationCell->True],

Cell[CellGroupData[{

Cell["\<\
Zero adjustment cost \[Omega] (regular Ramsey model)\
\>", "Subsubsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "qRamseyParamsBase.m"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", "=", "0"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "\[Omega]", " ", "measures", " ", "size", " ", "of", " ", "cost", " ", 
    "of", " ", "adjustment"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Quiet", "[", "SolvePolFunc", "]"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Quiet", "[", "]"}], " ", "supresses", " ", "some", " ", "error",
      " ", "messages", " ", "caused", " ", "by", " ", "\[Omega]"}], "=", 
    RowBox[{
    "0", " ", "that", " ", "do", " ", "not", " ", "actually", " ", "signal", 
     " ", "a", " ", "failed", " ", "solution"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[ScriptC]FuncAdjCost0", ",", "\[ScriptI]FuncAdjCost0", ",", 
     "\[ScriptJ]FuncAdjCost0"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"\[ScriptC]Func", ",", "\[ScriptI]Func", ",", "\[ScriptJ]Func"}], 
    "}"}]}], ";"}]}], "Input",
 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Benchmark calibration", "Subsubsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "qRamseyParamsBase.m"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SolvePolFunc", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[ScriptC]FuncBase", ",", "\[ScriptI]FuncBase", ",", 
     "\[ScriptJ]FuncBase"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"\[ScriptC]Func", ",", "\[ScriptI]Func", ",", "\[ScriptJ]Func"}], 
    "}"}]}], ";"}]}], "Input",
 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Calibration with huge costs of adjustment \[Omega]\
\>", "Subsubsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "qRamseyParamsBase.m"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   RowBox[{"5", "*", "\[Omega]Base"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SolvePolFunc", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[ScriptC]FuncAdjCostHi", ",", "\[ScriptI]FuncAdjCostHi", ",", 
     "\[ScriptJ]FuncAdjCostHi"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"\[ScriptC]Func", ",", "\[ScriptI]Func", ",", "\[ScriptJ]Func"}], 
    "}"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PolFuncAdjCost0VsHi", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
