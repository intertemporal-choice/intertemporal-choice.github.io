Cell[CellGroupData[{

Cell["Phase Diagrams", "Section",
 InitializationCell->True,
 CellChangeTimes->{{3.4177319013087997`*^9, 3.4177319076188*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"lPhaseDiag", "=", "\n", 
    RowBox[{"Show", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Lambda]Saddle", "[", "\[ScriptK]Plot", "]"}], ",", 
          RowBox[{
          "\[CapitalDelta]\[ScriptK]Equals0In\[Lambda]Space", "[", 
           "\[ScriptK]Plot", "]"}], ",", 
          RowBox[{
          "\[CapitalDelta]\[Lambda]Equals0", "[", "\[ScriptK]Plot", "]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[ScriptK]Plot", ",", 
          RowBox[{"\[ScriptK]SS", " ", "0.5"}], ",", 
          RowBox[{"1.5", "\[ScriptK]SS"}]}], "}"}], "\n", "    ", ",", 
        RowBox[{"AxesOrigin", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[ScriptK]SS", " ", "0.5"}], ",", "0.2"}], "}"}]}], ",", 
        RowBox[{"Ticks", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
             "\[ScriptK]SS", ",", 
              "\"\<\!\(\*OverscriptBox[\(\[ScriptK]\), \(\[Hacek]\)]\)\>\""}],
              "}"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
