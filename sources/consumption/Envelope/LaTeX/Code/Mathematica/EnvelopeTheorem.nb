Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}]], "Input",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "\[ScriptC]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[ScriptC]", "^", 
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Rho]"}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", "\[Rho]"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vFunc", "[", 
    RowBox[{"m1_", ",", "\[ScriptC]1_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"u", "[", "\[ScriptC]1", "]"}], " ", "+", " ", 
    RowBox[{"u", "[", 
     RowBox[{"m1", "-", "\[ScriptC]1"}], "]"}]}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[ScriptM]Min", ",", "\[ScriptM]Mid", ",", "\[ScriptM]Max"}], 
    "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
