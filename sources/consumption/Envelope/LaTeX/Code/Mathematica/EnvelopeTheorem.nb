  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[ScriptC]Min", ",", "\[ScriptC]Mid", ",", "\[ScriptC]Max"}], 
    "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[ScriptM]Min", ",", "\[ScriptM]Mid", ",", "\[ScriptM]Max"}], 
     "}"}], "/", "2"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Envelope", "=", 
