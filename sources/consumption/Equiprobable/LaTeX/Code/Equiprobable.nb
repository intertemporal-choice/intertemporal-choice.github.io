Cell[BoxData[{
 RowBox[{
  RowBox[{"NumOfPoints", "=", "15"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[CapitalTheta]1Pts", ",", "\[CapitalTheta]1Prb", ",", 
     "\[CapitalTheta]1EdgesOuter", ",", "\[CapitalTheta]1CDFOuter", ",", 
     "\[CapitalTheta]1EdgesInner", ",", "\[CapitalTheta]1CDFInner"}], "}"}], 
   " ", "=", " ", 
   RowBox[{"DiscreteApproxToMeanOneLogNormalWithEdges", "[", 
    RowBox[{"\[Sigma]\[Theta]1", ",", "NumOfPoints"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalTheta]2Pts", ",", "\[CapitalTheta]2Prb", ",", 
      "\[CapitalTheta]2EdgesOuter", ",", "\[CapitalTheta]2CDFOuter", ",", 
