    RowBox[{"CDFEdgePoints\[Theta]1\[Theta]2", "=", 
     RowBox[{"{", "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"CDFEdgePoints\[CapitalTheta]1\[CapitalTheta]2", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalTheta]1EdgesInner", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"\[CapitalTheta]2EdgesInner", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalTheta]1CDFInner", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"\[CapitalTheta]2CDFInner", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], "}"}]}], "]"}], ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CDFEdgePoints\[Theta]1\[Theta]2", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"\[CapitalTheta]1EdgesInner", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log", "[", 
           RowBox[{"\[CapitalTheta]2EdgesInner", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalTheta]1CDFInner", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"\[CapitalTheta]2CDFInner", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CDFEdgePoints\[Theta]1\[ScriptR]", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CurlyTheta]", "=", 
           RowBox[{"Log", "[", 
            RowBox[{"\[CapitalTheta]1EdgesInner", "[", 
