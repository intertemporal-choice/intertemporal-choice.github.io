Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CDFMidPoints\[Theta]1\[ScriptR]", "=", 
   RowBox[{"CDFMidPoints\[CapitalTheta]1\[CapitalTheta]2", "=", 
    RowBox[{"CDFMidPoints\[Theta]1\[Theta]2", "=", 
     RowBox[{"{", "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"CDFMidPoints\[CapitalTheta]1\[CapitalTheta]2", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalTheta]1Pts", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"\[CapitalTheta]2Pts", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], 
               RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
                RowBox[{"[", 
                 RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
                RowBox[{"[", "i", "]"}], "]"}], 
               RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], "/", "2"}]}]}], 
         "}"}]}], "]"}], ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CDFMidPoints\[Theta]1\[Theta]2", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"\[CapitalTheta]1Pts", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log", "[", 
           RowBox[{"\[CapitalTheta]2Pts", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], 
               RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
                RowBox[{"[", 
                 RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
                RowBox[{"[", "i", "]"}], "]"}], 
               RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], "/", "2"}]}]}], 
         "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CDFMidPoints\[Theta]1\[ScriptR]", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CurlyTheta]", "=", 
           RowBox[{"Log", "[", 
            RowBox[{"\[CapitalTheta]1Pts", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{"\[CapitalTheta]2Pts", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}], "+", "\[ScriptR]Prm", "+",
            "rFree", "+", 
           RowBox[{"\[Omega]Hat", " ", "\[CurlyTheta]"}], "+", "\[Zeta]"}], 
          ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], 
               RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
                RowBox[{"[", 
                 RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"\[CapitalTheta]1CDFOuter", "[", 
                RowBox[{"[", "i", "]"}], "]"}], 
               RowBox[{"\[CapitalTheta]2CDFOuter", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], "/", "2"}]}]}], 
         "}"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
