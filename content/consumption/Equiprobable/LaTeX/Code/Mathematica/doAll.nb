          "\"\<\!\(\*SubscriptBox[\(\[Theta]\), \(1\)]\)\>\"", ",", 
           "\"\<\[ScriptR]\>\"", ",", "\"\<PDF\>\""}], "}"}]}]}], "]"}], ",", 
      
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", "0", ",", "1", ",", "0.1"}], "}"}]}], "]"}]}],
    "]"}], ";"}]], "Input",
 InitializationCell->True],

