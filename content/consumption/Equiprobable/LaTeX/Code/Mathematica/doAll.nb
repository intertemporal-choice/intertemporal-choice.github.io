            RowBox[{"[", "j", "]"}], "]"}]}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CDFEdgePoints\[Theta]1\[ScriptR]", ",", 
